{
  "name": "opencode-xcode-testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A local OpenCode capability for running scoped Xcode tests while exposing only trustworthy, compact results to the model.",
  "scripts": {
    "check": "bun run typecheck && bun test",
    "test": "bun test",
    "typecheck": "bun node_modules/typescript/lib/tsc.js --noEmit"
  },
  "devDependencies": {
    "@opencode/client": "2.0.25",
    "@opencode/plugin": "2.0.25",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
